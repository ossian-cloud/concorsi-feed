# One page per call, stored in data/<first hex digit>.json.gz and served by page.php (see build.py).
RewriteEngine On
# Rules here replace the root .htaccess ones, so repeat its https / bare-domain redirect.
RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ossian.cloud%{REQUEST_URI} [R=301,L]
RewriteRule ^data/ - [F]
# Calendar files fold long lines (RFC 5545), so naive parsers request the address without .html.
RewriteRule ^([0-9a-f]{32})$ https://ossian.cloud/concorsi/concorso/$1.html [R=301,L]
RewriteRule ^([0-9a-f]{32})\.html$ page.php?id=$1 [L]
